# Database Configuration
#
# For CENTRALIZED cloud database (all hosts share same data):
# Uncomment and set your Supabase connection string
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres
#
# For LOCAL file database (default):
# Leave DATABASE_URL commented out, server will use SQLite
#
# For IN-MEMORY testing (no persistence):
# USE_MEMORY_DB=true

# Server Configuration
# PORT=3001
